JWT_SECRET=changeme
SESSION_SECRET=changeme
SESSION_COOKIE_HTTPS_ONLY=FALSE

GMAIL_USERNAME=changeme
GMAIL_PASSWORD=changeme

FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# OAuth runs entirely in the Next.js app: it owns the client secrets, the
# redirect URI and the code->token exchange, and it verifies the credential it
# gets back (Google's ID token against Google's signing keys, GitHub's access
# token against the GitHub API). Only then does it state the result to
# POST /api/auth/{provider}/bridge here.
#
# OAUTH_BRIDGE_SECRET is the trust boundary. This service checks that signature
# and nothing else - it never sees a Google client ID, a redirect URI or a
# provider token. It must be byte-identical to the web app's value, and
# anyone holding it could mint any identity, so keep it out of version control.
OAUTH_BRIDGE_SECRET=changeme

POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=rampart
POSTGRES_HOST=localhost

REDIS_HOST=localhost
